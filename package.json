{
  "name": "@crisfcodes/saleor-native-sdk",
  "version": "0.1.5",
  "description": "This package contains all queries and mutations that are used in saleor storefront adapted to react native. It can be used for semi-custom or fully-custom (with ability to extend existing queries) react native storefront solutions.",
  "homepage": "https://github.com/crisfcodes/saleor-sdk",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crisfcodes/saleor-sdk"
  },
  "scripts": {
    "build": "tsc",
    "build-types": "apollo codegen:generate --target=typescript gqlTypes && rm -rf src/gqlTypes && move-file gqlTypes src/gqlTypes && globstar -- jscodeshift -t scripts/fixImportPaths.ts src/**/gqlTypes/* --parser=tsx",
    "clean": "rimraf lib",
    "lint": "eslint \"src/**/*.@(tsx|ts|jsx|js)\" --fix && prettier --check \"src/**/*.@(tsx|ts|jsx|js)\" --write",
    "prepare": "npm run clean && npm run build",
    "release": "np",
    "start": "tsc --watch",
    "test": "jest"
  },
  "keywords": [
    "saleor",
    "sdk",
    "storefront",
    "shop",
    "typescript",
    "apollo",
    "graphql",
    "react native",
    "react-native"
  ],
  "authors": [
    "Mirumee <hello@mirumee.com>",
    "Cristian Flórez <cristianflorez0501@gmail.com>"
  ],
  "bugs": {
    "url": "https://github.com/crisfcodes/saleor-sdk/issues"
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@wry/equality": "^0.5.7",
    "apollo3-cache-persist": "^0.15.0",
    "dayjs": "^1.10.4",
    "extract-files": "11.0.0",
    "graphql": "^16.11.0",
    "lodash": "^4.17.15",
    "lodash-es": "^4.17.15"
  },
  "devDependencies": {
    "@pollyjs/adapter-node-http": "^6.0.6",
    "@pollyjs/core": "^6.0.6",
    "@pollyjs/persister-fs": "^6.0.6",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/jest": "^30.0.0",
    "@types/jscodeshift": "^17.3.0",
    "@types/lodash": "^4.14.155",
    "@types/pollyjs__adapter-node-http": "^6.0.5",
    "@types/pollyjs__persister-fs": "^6.0.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-native": "^0.73.0",
    "@types/setup-polly-jest": "^0.5.0",
    "@types/webappsec-credential-management": "^0.6.9",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "apollo": "^2.27.4",
    "apollo-upload-client": "^18.0.1",
    "eslint": "^9.31.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globstar": "^1.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "jest-expo": "^53.0.9",
    "jscodeshift": "^17.3.0",
    "lint-staged": "^16.1.2",
    "move-file-cli": "^3.0.0",
    "node-fetch": "^3.3.2",
    "np": "^10.2.0",
    "prettier": "^3.6.2",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0",
    "rimraf": "^6.0.1",
    "setup-polly-jest": "^0.11.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@react-native-community/netinfo": "6.0.0",
    "graphql": "^15.5.0",
    "react": "17.0.1",
    "react-native": "0.64.0"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "type": "commonjs",
  "typings": "./lib/index.d.ts"
}
